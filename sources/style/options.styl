.menu .contents .options-content

    .settings-header
        display flex
        align-items center
        justify-content space-between
        gap 14px
        padding-bottom 18px
        margin-bottom 18px
        border-bottom 1px solid rgba(112, 206, 255, 0.16)

    .settings-title-group
        display flex
        align-items center
        gap 13px

    .settings-badge
        display flex
        align-items center
        justify-content center
        width 42px
        height 42px
        border-radius 13px
        background linear-gradient(145deg, #1d8cff 0%, #0b46ba 100%)
        border 1px solid rgba(155, 232, 255, 0.45)
        box-shadow 0 6px 18px rgba(24, 128, 255, 0.35)
        flex-shrink 0

        img
            width 21px
            height 21px
            filter brightness(1.15)

    .settings-heading
        display flex
        flex-direction column
        gap 2px

    .settings-title
        font-family 'Nunito', sans-serif
        font-size 20px
        font-weight 900
        letter-spacing 0.01em
        color #ffffff
        line-height 1.15

    .settings-subtitle
        font-family 'Nunito', sans-serif
        font-size 12.5px
        font-weight 400
        color rgba(159, 213, 255, 0.72)

    .close
        position relative
        display flex
        align-items center
        justify-content center
        width 36px
        height 36px
        border-radius 11px
        background rgba(34, 122, 255, 0.16)
        border 1px solid rgba(122, 212, 255, 0.28)
        cursor pointer
        flex-shrink 0
        transition background 0.18s ease, border-color 0.18s ease, transform 0.18s ease

        html:not(.is-mode-touch) &:hover
            background rgba(34, 122, 255, 0.34)
            border-color rgba(145, 228, 255, 0.65)
            transform scale(1.06)

        .icon
            &.is-default
                width 14px
                height 14px

                .is-mode-gamepad.is-gamepad-xbox &
                    display none

            &.is-xbox
                display none
                justify-content center
                align-items center
                border 2px solid #ffffff
                width 24px
                height 24px
                border-radius 12px
                font-size 12px
                font-weight 700

                .is-mode-gamepad.is-gamepad-xbox &
                    display flex

    .settings-list
        display flex
        flex-direction column
        gap 10px

    .setting-row
        display flex
        align-items center
        justify-content space-between
        gap 14px
        padding 12px 14px
        border-radius 14px
        background rgba(255, 255, 255, 0.035)
        border 1px solid rgba(110, 200, 255, 0.13)
        transition background 0.18s ease, border-color 0.18s ease

        html:not(.is-mode-touch) &:hover
            background rgba(32, 124, 255, 0.09)
            border-color rgba(122, 214, 255, 0.3)

    .setting-info
        display flex
        flex-direction column
        gap 2px
        min-width 0

    .setting-label
        font-family 'Nunito', sans-serif
        font-size 15px
        font-weight 700
        color #f2f8ff
        line-height 1.2

    .setting-desc
        font-family 'Nunito', sans-serif
        font-size 12px
        color rgba(164, 206, 245, 0.68)
        line-height 1.25

    .setting-btn
        position relative
        display inline-flex
        align-items center
        justify-content center
        gap 7px
        min-width 96px
        height 36px
        padding 0 14px
        border-radius 10px
        font-family 'Nunito', sans-serif
        font-size 13px
        font-weight 800
        letter-spacing 0.02em
        color #eef7ff
        background rgba(26, 108, 232, 0.22)
        border 1px solid rgba(114, 204, 255, 0.32)
        cursor pointer
        flex-shrink 0
        transition background 0.18s ease, border-color 0.18s ease, transform 0.15s ease, box-shadow 0.18s ease

        html:not(.is-mode-touch) &:not(.is-disabled):hover
            background rgba(34, 134, 255, 0.38)
            border-color rgba(154, 230, 255, 0.72)
            box-shadow 0 4px 14px rgba(26, 132, 255, 0.32)
            transform translateY(-1px)

        &:not(.is-disabled):active
            transform translateY(0) scale(0.97)

        &.is-primary
            background linear-gradient(135deg, #1f8cff 0%, #0d52d1 100%)
            border-color rgba(150, 228, 255, 0.55)
            box-shadow 0 4px 14px rgba(22, 122, 255, 0.34)

            html:not(.is-mode-touch) &:hover
                background linear-gradient(135deg, #359bff 0%, #1562ea 100%)
                box-shadow 0 6px 18px rgba(32, 144, 255, 0.48)

        &.is-disabled
            cursor default

        &.is-success
            background rgba(16, 185, 129, 0.16)
            border-color rgba(52, 211, 153, 0.42)
            color #7ef5c9

            .status-dot
                background #34d399
                box-shadow 0 0 8px #34d399

        &.is-danger
            background rgba(244, 63, 94, 0.18)
            border-color rgba(251, 113, 133, 0.45)
            color #ff9bb0

            .status-dot
                background #fb7185
                box-shadow 0 0 8px #fb7185

        .status-dot
            width 7px
            height 7px
            border-radius 50%
            flex-shrink 0

    .audio-toggle
        img
            width 20px
            height 20px

            &.audio-off
                display none

            &.audio-on
                display block

        html.is-audio-muted &
            background rgba(244, 63, 94, 0.16)
            border-color rgba(251, 113, 133, 0.38)

            img
                &.audio-on
                    display none

                &.audio-off
                    display block
